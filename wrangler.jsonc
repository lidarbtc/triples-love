{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "triples-love",
  "account_id": "35b3305bfd095935de7070f4d99d6929",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      // Automatic invocation URLs can include OAuth code/state. The application
      // emits allowlisted request.complete records instead.
      "invocation_logs": false
    },
    "traces": { "enabled": false }
  },
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ORIGIN": "https://triples.love"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "triples-love-db",
      "database_id": "bc011845-ba26-403d-b904-c5325ce1d1f3",
      "migrations_dir": "migrations"
    }
  ]
}
