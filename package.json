{
  "name": "triples-love",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:dev": "wrangler dev",
    "pretest": "node scripts/seed-projects.mjs",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "pretest:worker": "node scripts/seed-projects.mjs",
    "test:worker": "node tests/worker-d1.mjs && node tests/worker-auth.mjs",
    "test:flow": "npm run build && node tests/worker-flow.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/seed-projects.mjs && wrangler d1 execute DB --local --file=.wrangler/seed-projects.sql",
    "db:seed:remote": "node scripts/seed-projects.mjs && wrangler d1 execute DB --remote --file=.wrangler/seed-projects.sql",
    "deploy": "npm run build && wrangler deploy",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "esbuild": "^0.27.3",
    "miniflare": "^4.20260507.1",
    "playwright": "^1.59.1",
    "svelte": "^5.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  }
}
