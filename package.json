{
  "name": "triples-love",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build && node scripts/add-scheduled-handler.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "cf:dev": "wrangler dev",
    "pretest": "node scripts/seed-projects.mjs",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "pretest:worker": "node scripts/seed-projects.mjs",
    "test:worker": "node tests/worker-d1.mjs && node tests/worker-auth.mjs",
    "test:flow": "npm run build && node tests/worker-flow.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/seed-projects.mjs && wrangler d1 execute DB --local --file=.wrangler/seed-projects.sql",
    "db:seed:remote": "node scripts/seed-projects.mjs && wrangler d1 execute DB --remote --file=.wrangler/seed-projects.sql",
    "deploy": "npm run build && wrangler deploy",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "playwright": "^1.65.1",
    "svelte": "^5.59.1",
    "vite": "^8.3.8",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^2.0.1",
    "parse5": "^8.1.1"
  }
}
